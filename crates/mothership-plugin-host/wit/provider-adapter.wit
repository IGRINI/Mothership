package mothership:plugin@0.1.0;

/// Host-owned network capability (decision B): plugins never open sockets — they
/// ask the host to perform requests, so the host keeps ownership of sockets,
/// TLS, timeouts, observability and (later) auth injection. v1 is a minimal
/// status probe; this grows into full request/response + streaming + secrets.
interface host-http {
    /// Perform a GET and return the HTTP status code, or an error string.
    fetch-status: func(url: string) -> result<u16, string>;
}

/// The contract every provider-adapter plugin exports, plus the host
/// capabilities it imports. Phase 1 covers identity + catalog and the first
/// host capability; later phases add chat request-building / event-parsing and
/// streaming + secrets-as-handles.
world provider-adapter {
    import host-http;

    /// Static identity, read by the host at load time to register the provider
    /// and populate the UI (model picker + settings) without rebuilding the app.
    record adapter-info {
        provider-id: string,
        provider-label: string,
        abi-version: u32,
    }

    /// One entry in a provider's model catalog.
    record model-info {
        id: string,
        label: string,
        family: string,
        description: string,
        recommended: bool,
    }

    export info: func() -> adapter-info;
    export bundled-models: func() -> list<model-info>;

    /// Diagnostic export: forwards to the host-http capability and returns what
    /// it got, proving a plugin can drive a network request without owning a
    /// socket. Real adapters will use this capability inside chat/catalog calls.
    export probe-status: func(url: string) -> result<u16, string>;
}
