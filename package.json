{
  "name": "mothership",
  "version": "0.1.0",
  "description": "Tauri 2 + SolidJS desktop shell with SQLite and a Rust sidecar.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:build:release": "node scripts/build-sidecar.mjs --release",
    "adapters:install": "node scripts/install-adapters.mjs",
    "adapters:install:release": "node scripts/install-adapters.mjs --release",
    "types:gen": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:sign:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-release-windows.ps1"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.160",
    "@tanstack/solid-virtual": "^3.13.27",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-solid": "^1.14.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.3",
    "solid-markdown": "^2.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
