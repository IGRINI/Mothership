{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mothership",
  "version": "0.1.0",
  "identifier": "dev.mothership.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build:release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mothership",
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#07101aff",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "externalBin": [
      "binaries/mothership-sidecar",
      "binaries/codex-adapter",
      "binaries/openrouter-adapter",
      "binaries/claude-agent-adapter",
      "binaries/claude-agent-sdk-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
